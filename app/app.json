{
  "expo": {
    "name": "TM",
    "slug": "TM",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.jpg",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon.jpg"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#029EEC",
        "foregroundImage": "./assets/icon.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.subha002.app"
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-share-intent",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#029EEC",
          "image": "./assets/splash.jpg",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
